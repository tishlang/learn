{
  "name": "tish-learn",
  "version": "0.1.0",
  "description": "Learn to code with Tish — fully featured education platform. 100% Tish, zero JS deps, zero backend.",
  "license": "PIF",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tish run --feature fs --feature http build-css.tish",
    "dev": "just dev",
    "build": "just build",
    "build:legacy": "tish run --feature fs --feature http --feature process dev-server.tish",
    "link-local": "npm link ../lattish ../tish-ide-panels ../tish-tailwind ../tish-browser-server",
    "unlink-local": "npm install",
    "vercel-build": "bash vercel-build.sh"
  },
  "dependencies": {
    "@tishlang/lattish": "latest",
    "@tishlang/tish-ide-panels": "latest",
    "@tishlang/tish-tailwind": "latest",
    "@tishlang/tish-browser-server": "latest"
  },
  "devDependencies": {
    "@tishlang/tish": "latest",
    "extra-just": "latest"
  }
}
