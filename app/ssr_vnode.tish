// Serialize Lattish host vnodes (string tags + Fragment only) to static HTML.
// Used by prerender.tish — do not pass function components; use plain h("div", …).

import { Fragment } from "./ssr_h.tish"
import { escapeHtmlText, escapeHtmlAttr } from "./html_escape.tish"

fn isVoidTag(tag) {
  return tag === "area" || tag === "base" || tag === "br" || tag === "col"
    || tag === "embed" || tag === "hr" || tag === "img" || tag === "input"
    || tag === "link" || tag === "meta" || tag === "param" || tag === "source"
    || tag === "track" || tag === "wbr"
}

fn propsToAttrString(tag, props) {
  if (props === null) { return "" }
  let keys = Object.keys(props)
  let out = ""
  let ki = 0
  while (ki < keys.length) {
    let k = keys[ki]
    let v = props[k]
    if (k === "key" || k === "ref" || k === "children" || k === "dangerouslySetInnerHTML") {
      ki = ki + 1
      continue
    }
    if (k.length >= 2 && k.charAt(0) === "o" && k.charAt(1) === "n") {
      ki = ki + 1
      continue
    }
    if (v === true) {
      out = out + " " + k
    } else if (v === false || v === null) {
      // omit
    } else if (k === "class" || k === "className") {
      out = out + " class=\"" + escapeHtmlAttr(String(v)) + "\""
    } else if (k === "style" && typeof v === "object") {
      // skip inline styles in SSG shell (none today)
    } else {
      out = out + " " + k + "=\"" + escapeHtmlAttr(String(v)) + "\""
    }
    ki = ki + 1
  }
  return out
}

fn vnodeToHtmlInner(node) {
  if (node === null || node === false || node === true) { return "" }
  if (typeof node === "string") {
    return escapeHtmlText(node)
  }
  if (typeof node === "number") {
    return escapeHtmlText(String(node))
  }
  if (typeof node !== "object") { return "" }
  if (Array.isArray(node)) {
    return vnodeListToHtml(node)
  }
  if (node.tag === Fragment) {
    return vnodeListToHtml(node.children)
  }
  if (typeof node.tag !== "string") {
    return ""
  }
  let tag = node.tag
  let props = node.props !== null ? node.props : {}
  let dang = null
  if ("dangerouslySetInnerHTML" in props) {
    dang = props["dangerouslySetInnerHTML"]
  }
  let attrs = propsToAttrString(tag, props)
  let lt = "<"
  let gt = ">"
  let slash = "/"
  if (isVoidTag(tag)) {
    return lt + tag + attrs + " " + slash + gt
  }
  let inner = ""
  if (dang !== null && typeof dang === "object" && "__html" in dang) {
    let raw = dang["__html"]
    inner = raw !== null ? String(raw) : ""
  } else {
    inner = vnodeListToHtml(node.children)
  }
  return lt + tag + attrs + gt + inner + lt + slash + tag + gt
}

fn vnodeListToHtml(children) {
  if (children === null) { return "" }
  if (!Array.isArray(children)) {
    return vnodeToHtmlInner(children)
  }
  let acc = ""
  let i = 0
  while (i < children.length) {
    let piece = vnodeToHtmlInner(children[i])
    acc = acc + piece
    i = i + 1
  }
  return acc
}

export fn vnodeToHtml(node) {
  let html = vnodeToHtmlInner(node)
  return html
}
